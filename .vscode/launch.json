{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LectroLend API (Spring Boot)",
      "type": "java",
      "request": "launch",
      "mainClass": "rw.auca.lectrolend.LectroLendApplication",
      "projectName": "lectrolend",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "DB_HOST": "localhost",
        "DB_PORT": "5432",
        "DB_NAME": "lectrolend",
        "DB_USER": "postgres",
        "DB_PASSWORD": "${input:dbPassword}"
      }
    },
    {
      "name": "LectroLend Web (React)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm install && npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "LectroLend: API + Web",
      "configurations": ["LectroLend API (Spring Boot)", "LectroLend Web (React)"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "dbPassword",
      "type": "promptString",
      "description": "PostgreSQL password for user 'postgres'",
      "password": true
    }
  ]
}
