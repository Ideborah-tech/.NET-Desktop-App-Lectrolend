<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LectroLend.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same schema as the Spring Boot Flyway migration, so both apps can share one database. -->
    <EmbeddedResource Include="Data\Schema.sql" LogicalName="LectroLend.Core.Schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LectroLend.Core.Tests" />
  </ItemGroup>

</Project>
